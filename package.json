{
  "name": "renovation-business-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "build": "npm run check && vite build && tsx scripts/prerender.tsx",
    "preview": "vite preview --host 127.0.0.1",
    "publish:github": "node scripts/publish-github.mjs",
    "test:browser": "node scripts/verify-browser.mjs",
    "test:visit": "node scripts/verify-visit.mjs",
    "test:renovations": "node scripts/verify-renovations.mjs",
    "test:routes": "node scripts/verify-routing.mjs",
    "test:header": "node scripts/verify-header.mjs",
    "test:hero": "node scripts/verify-hero.mjs",
    "qa:clean": "node -e \"require('fs').rmSync('qa',{recursive:true,force:true})\""
  },
  "dependencies": {
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "playwright": "1.63.0",
    "tsx": "^4.20.0",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
